# =============================================================================
# PLANTILLA .env del repo raíz — copiar a .env (NO versionar .env)
#   cp .env.example .env
# Solo puertos y config de orquestación. Los SECRETOS van en el .env de cada
# submódulo (./SERVICIO-API-A/.env, etc.), nunca aquí.
# =============================================================================

# Puertos publicados en el host (cámbialos si chocan con otros procesos)
API_A_PORT=3000
API_B_PORT=3001
ADMIN_PORT=3002

# Entorno por defecto
NODE_ENV=development
